# Copy to backend.env on your server, replace values, and keep it outside Git.
XUNWEI_HOST=0.0.0.0
XUNWEI_PORT=8877
XUNWEI_DATA_DIR=/data
# Public visitors receive isolated temporary sessions and choose custom/shared AI.
XUNWEI_PUBLIC_MODE=1
# Administrator only: use a fresh random string, separate from the AI provider key.
# Never put this token in GitHub Pages, deployment-config.js, or visitor settings.
XUNWEI_ACCESS_TOKEN=replace-with-a-long-random-access-token
# Exact origin: no /repository/ path, trailing slash, or wildcard.
XUNWEI_ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io
# Actual Host header forwarded to Python, optionally comma separated.
XUNWEI_PUBLIC_HOSTS=search-api.example.com,127.0.0.1:8877
# Optional owner-funded AI, supplied only through the backend hosting environment.
# Leave AI_API_KEY empty to offer visitor-supplied AI without a shared owner key.
AI_BASE_URL=https://api.a6api.com/v1
AI_MODEL=deepseek-v4.1-flash
AI_API_KEY=
